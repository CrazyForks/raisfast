# Production environment overrides
# This file is loaded after .env when APP_PROFILE=production
#
# IMPORTANT: Set these values before deploying!
# - JWT_SECRET must be a strong random key (>= 32 chars)
# - CORS_ORIGINS must be set to your actual domain(s)
# - DATABASE_URL should point to your production database

APP_ENV=production

# JWT_SECRET=<YOUR_PRODUCTION_SECRET>
# CORS_ORIGINS=https://yourdomain.com
# DATABASE_URL=sqlite:/var/lib/raisfast/raisfast.db?mode=rwc

# Production: stricter rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300
